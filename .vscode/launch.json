{
    "version": "0.2.0",
    "configurations": [

        // ════════════════════════════════════════════════════════
        //  매일 사용 (경마일마다)
        //  --date 생략 시 자동으로 오늘 날짜 사용
        // ════════════════════════════════════════════════════════

        {
            // [아침] 오늘 경주 예측 → 콘솔에 전체 경주 + 베팅 추천 출력
            "name": "① 예측 (오늘)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "predict"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [저녁] 경주 결과 스크래핑 → win_odds DB 업데이트 → horse_race_history 재구성
            "name": "② 결과 업데이트 (저녁)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "update-results","--date", "2026-07-04"], //  ,"--date", "2026-07-11"
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // 여러 날짜를 한 번에 놓쳤을 때 → --start-date ~ --end-date 기간 전체를 순회하며 업데이트
            // ★ 아래 두 날짜를 놓친 기간으로 변경 (YYYY-MM-DD 형식)
            "name": "② 결과 업데이트 (기간)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "update-results", "--start-date", "2026-07-10", "--end-date", "2026-07-12"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  특정 날짜 예측
        // ════════════════════════════════════════════════════════

        {
            "name": "예측 - 특정날짜",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "predict", "--date", "2026-07-25"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  백테스트 (정확도 측정 — 모델/DB는 건드리지 않고 채점만 함)
        // ════════════════════════════════════════════════════════

        {
            // 연승(top3) 백테스트 - 두수 필터 × 확신도(top3_probability) 임계값 조합별 적중률
            // 결과는 콘솔 출력 + BackTestReport/Result_top3_날짜_시간.md로 자동 저장됨
            "name": "백테스트 - 연승(top3)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/backtest_top3.py",
            "args": ["--start", "2026-05-01", "--end", "2026-06-25"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // 단승(win) 백테스트 - Precision@1, 인기마(최저배당) 기준선 비교, 임계값별 적중률
            // 결과는 콘솔 출력 + BackTestReport/Result_win_날짜_시간.md로 자동 저장됨
            "name": "백테스트 - 단승(win)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/backtest_win.py",
            "args": ["--start", "2026-05-01", "--end", "2026-06-25"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  놓쳤을 때 (백필)  ← 이 3개를 순서대로 실행
        //
        //  [1단계] 데이터 수집 (백필)   - 날짜 수정 후 실행
        //  [2단계] 히스토리 재구성 (기간) - 같은 날짜로 수정 후 실행
        //  [3단계] 모델 재학습           - 날짜 수정 없이 바로 실행
        // ════════════════════════════════════════════════════════

        {
            // [1단계] 놓친 기간 경주 데이터 API 수집 (race_entries, win_odds 포함)
            // ★ 아래 두 날짜를 놓친 기간으로 변경 (YYYYMMDD 형식)
            "name": "[백필 1] 데이터 수집 (기간)",
            "type": "debugpy",
            "request": "launch",
            "module": "library.collector_races",
            "args": ["20260701", "20260801"],   // ← 시작일, 종료일 (YYYYMMDD)
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [2단계] 수집한 기간의 horse_race_history만 재구성 (전체보다 빠름)
            // ★ 아래 두 날짜를 1단계와 동일하게 변경 (YYYY-MM-DD 형식)
            "name": "[백필 2] 히스토리 재구성 (기간)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/core/history_rebuilder.py",
            "args": ["2026-06-01", "2026-06-07"],   // ← 시작일, 종료일 (YYYY-MM-DD)
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [3단계] 새 데이터 반영해서 모델 재학습 (--end-date 생략 시 오늘까지)
            "name": "[백필 3] 모델 재학습",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode", "train",
                "--start-date", "2024-01-01"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  하이퍼파라미터 튜닝 (선택 — 실행 주기: 월 1회 이하)
        //  데이터가 크게 늘었을 때(예: 한 달치 이상 누적) 또는 최초 1회만 실행하면 충분.
        //  튜닝만으로는 모델이 바뀌지 않으므로, 실행 후 반드시 [백필 3] 모델 재학습을 다시 돌릴 것.
        // ════════════════════════════════════════════════════════

        {
            // 60 trials × 2모델(XGBoost·LightGBM), 약 20~40분 소요 → models/best_params.json 저장
            // 이후 모델 재학습을 실행하면 저장된 파라미터가 자동 적용됨
            "name": "[선택·월1회] 하이퍼파라미터 튜닝",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "tune", "--start-date", "2024-01-01"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
