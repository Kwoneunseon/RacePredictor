{
    "version": "0.2.0",
    "configurations": [

        // ════════════════════════════════════════════════════════
        //  매일 사용 (경마일마다)
        //  --date 생략 시 자동으로 오늘 날짜 사용
        // ════════════════════════════════════════════════════════

        {
            // [아침] 오늘 경주 예측 → 콘솔에 전체 경주 + 베팅 추천 출력
            "name": "① 예측 (오늘)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "predict"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [저녁] 경주 결과 스크래핑 → win_odds DB 업데이트 → horse_race_history 재구성
            "name": "② 결과 업데이트 (저녁)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "update-results"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  경마장별 개별 예측
        // ════════════════════════════════════════════════════════

        {
            "name": "예측 - 서울",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "predict", "--meet", "1"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "예측 - 제주",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "predict", "--meet", "2"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "예측 - 부산",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "predict", "--meet", "3"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  놓쳤을 때 (백필)  ← 이 3개를 순서대로 실행
        //
        //  [1단계] 데이터 수집 (백필)   - 날짜 수정 후 실행
        //  [2단계] 히스토리 재구성 (기간) - 같은 날짜로 수정 후 실행
        //  [3단계] 모델 재학습           - 날짜 수정 없이 바로 실행
        // ════════════════════════════════════════════════════════

        {
            // [1단계] 놓친 기간 경주 데이터 API 수집 (race_entries, win_odds 포함)
            // ★ 아래 두 날짜를 놓친 기간으로 변경 (YYYYMMDD 형식)
            "name": "[백필 1] 데이터 수집 (기간)",
            "type": "debugpy",
            "request": "launch",
            "module": "library.collector_races",
            "args": ["20260601", "20260607"],   // ← 시작일, 종료일 (YYYYMMDD)
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [2단계] 수집한 기간의 horse_race_history만 재구성 (전체보다 빠름)
            // ★ 아래 두 날짜를 1단계와 동일하게 변경 (YYYY-MM-DD 형식)
            "name": "[백필 2] 히스토리 재구성 (기간)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/core/history_rebuilder.py",
            "args": ["2026-06-01", "2026-06-07"],   // ← 시작일, 종료일 (YYYY-MM-DD)
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [선택] 하이퍼파라미터 튜닝 후 재학습 — 처음 또는 데이터 크게 늘었을 때
            "name": "[백필 3-선택] 하이퍼파라미터 튜닝",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "tune", "--start-date", "2024-01-01"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // [3단계] 새 데이터 반영해서 모델 재학습 (--end-date 생략 시 오늘까지)
            "name": "[백필 3] 모델 재학습",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode", "train",
                "--start-date", "2024-01-01"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  주간 루틴 (일주일에 1~2회)
        // ════════════════════════════════════════════════════════

        {
            // 하이퍼파라미터 탐색 (60 trials × 2모델, 약 20~40분 소요) → best_params.json 저장
            // 이후 '모델 재학습' 실행하면 자동으로 최적 파라미터 적용됨
            "name": "하이퍼파라미터 튜닝 (1회성)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "tune", "--start-date", "2024-01-01"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // 최신 데이터로 모델 재학습 (--end-date 생략 시 오늘까지, 약 5~10분 소요)
            "name": "모델 재학습",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode", "train",
                "--start-date", "2024-01-01"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // 오늘까지 경주 데이터 API 수집 (race_entries, 마필/기수/조교사 정보)
            "name": "데이터 수집 (오늘)",
            "type": "debugpy",
            "request": "launch",
            "module": "library.collector_races",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            // horse_race_history 전체 재구성 (오래 걸림, 월 1회 권장)
            "name": "히스토리 전체 재구성",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/core/history_rebuilder.py",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },

        // ════════════════════════════════════════════════════════
        //  진단 / 점검
        // ════════════════════════════════════════════════════════

        {
            // DB 연결 · 모델 상태 · 재학습 필요 여부 한눈에 확인
            "name": "Status 확인",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "status"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
